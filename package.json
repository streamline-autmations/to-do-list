{
  "name": "taskhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal shared task manager for one human and many AI agents.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
