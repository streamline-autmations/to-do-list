# Copy to .env.local for local development, and set the same names in Vercel
# (Project -> Settings -> Environment Variables). Never commit the real file.

# --- Database (server-only) -------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Use the password you chose when creating the project. Do NOT use the anon/service-role keys.
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Web login --------------------------------------------------------------
# Generate with:  npm run hash-password
# (A plain TASKHUB_PASSWORD is also accepted, but the hash is recommended.)
TASKHUB_PASSWORD_HASH=
# Random string, 32+ chars. Signs the login cookie.  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TASKHUB_SESSION_SECRET=

# --- Machine access for the CLI and AI agents -------------------------------
# Random string, 32+ chars (same generator as above). Comma-separate two tokens to rotate without downtime.
TASKHUB_API_TOKEN=
